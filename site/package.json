{
  "name": "cdp-api-docs-builder-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.1"
  },
  "scripts": {
    "gen:api": "mkdir -p docs/api/reference && docusaurus gen-api-docs all",
